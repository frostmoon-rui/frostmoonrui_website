{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frostmoonrui-website",
  "main": "src/worker.js",
  "keep_vars": true,
  "ratelimits": [{"name":"ADMIN_LOGIN_LIMIT","namespace_id":"73620491","simple":{"limit":5,"period":60}}],
  "compatibility_date": "2026-10-18",
  "routes": [
    {"pattern": "frostmoonrui.com/*", "zone_name": "frostmoonrui.com"}
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
